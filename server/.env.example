# Copy to .env and fill in.
PORT=8787
APP_URL=http://localhost:5173/#/settings

# AI engine: claude-code runs `claude -p` locally (uses your Claude plan).
# For the SaaS version, swap runClaude() for the Claude Agent SDK + ANTHROPIC_API_KEY.
RYPL_ENGINE=claude-code
CLAUDE_BIN=claude
# Model for generation. sonnet is fast; set to opus for higher quality (slower), or leave empty for your CLI default.
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=600000
# ANTHROPIC_API_KEY=

# Instagram API with Instagram Login (Meta app → Instagram product)
IG_APP_ID=
IG_APP_SECRET=
# Optional shortcut for your own account: paste a token from Meta dashboard → Instagram →
# API setup with Instagram login → Generate token. Skips the Connect button. Expires after ~60 days.
IG_ACCESS_TOKEN=
IG_REDIRECT_URI=http://localhost:8787/api/instagram/callback
IG_API_VERSION=v21.0

# Publishing: Instagram downloads media from a public link, so renders are uploaded to Cloudinary first.
# Free account at cloudinary.com -> Dashboard shows these three values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI pictures inside posts/reels (OpenAI). Leave empty to use the OPENAI_API_KEY from your system, or set RYPL_AI_IMAGES=off to disable.
# OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low (~15s, cheapest) | medium | high (slowest, best)
OPENAI_IMAGE_QUALITY=medium
# Voiceover for reels (OpenAI text-to-speech). Claude picks the voice per reel; this is only the fallback.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=ash

# ---- Shared workspace (Supabase): login + shared calendar, brand and creatives ----
# Leave empty to run purely locally. Supabase Dashboard -> Project Settings -> API (Data API + API keys).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret - server only, never share or put in the app. ("service_role" / secret key)
SUPABASE_SERVICE_ROLE_KEY=
# Only these emails can sign in (comma-separated).
RYPL_ALLOWED_EMAILS=
# Optional name for this laptop in the shared calendar (defaults to the computer name).
# RYPL_MACHINE=
